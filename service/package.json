{
  "name": "@skybridgeskills/vcalm-status-service",
  "version": "0.1.0",
  "description": "A VCALM-conforming Bitstring Status List service.",
  "type": "module",
  "private": true,
  "main": "./dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "dotenvx run -f .env --ignore=MISSING_ENV_FILE -- tsx watch src/server.ts",
    "test": "dotenvx run -f src/test-fixtures/.env.testing -- vitest run",
    "coverage": "dotenvx run -f src/test-fixtures/.env.testing -- vitest run --coverage",
    "lint": "eslint"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.4",
    "@skybridgeskills/vc-signer": "workspace:*",
    "hono": "^4.7.11",
    "zod": "^3.25.56"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^1.44.1",
    "@types/node": "^22.15.30",
    "@vitest/coverage-v8": "^3.2.3",
    "tsx": "^4.20.1",
    "typescript": "^5.8.3",
    "vitest": "^3.2.3"
  },
  "engines": {
    "node": ">=24.0"
  },
  "license": "MIT"
}
