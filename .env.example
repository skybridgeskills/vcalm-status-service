# Copy to service/.env for local runs. Every value is optional, and the values
# below are the service's own defaults — except SIGNING_MODE, which is noted
# where it appears.

# development | test | production
NODE_ENV=development

# TCP port the server binds on 0.0.0.0.
PORT=4008

# Origin this service is reachable at. Canonical status list URLs are
# {PUBLIC_BASE_URL}/status-lists/{id} and are fixed at create time, so changing
# this after lists exist breaks already-issued credentials. Behind ngrok, set it
# to the ngrok origin.
PUBLIC_BASE_URL=http://localhost:4008

# debug | info | warn | error
LOG_LEVEL=info

# Backend selection. Each mode names an implementation of the matching service
# interface. More modes arrive with the tenancy work.
#
# STORAGE_MODE: memory | sqlite | postgres — the code default is `memory`, but
# a run whose status list URLs should still resolve after a restart wants
# `sqlite`.
#   memory   — process memory; refused when NODE_ENV=production
#   sqlite   — a file, via SQLITE_FILE; the local and ngrok backend
#   postgres — via DATABASE_URL; the deployed backend
#
# SIGNING_MODE: local | http | fake — the code default is `fake`, but a local
# run that should produce verifiable credentials wants `local`.
#   local — sign in-process with @skybridgeskills/vc-signer, using the key
#           material on the issuer instance each list is bound to
#   http  — call a provisioned dcc-signing-service, which holds the key
#   fake  — a test double producing an unverifiable proof; refused when
#           NODE_ENV=production
#
# TENANT_REGISTRY_MODE: env | memory — `memory` starts with no tenants at all
# and so authenticates nobody; it is for tests, and is refused when
# NODE_ENV=production.
STORAGE_MODE=sqlite
SIGNING_MODE=local
TENANT_REGISTRY_MODE=env

# SQLite database file, created along with its parent directory on first run.
# Mount its directory as a volume: the lists in it are what already-issued
# credentials resolve against.
SQLITE_FILE=./data/status-lists.db

# Postgres DSN. Required when STORAGE_MODE=postgres, ignored otherwise.
# DATABASE_URL=postgres://user:password@localhost:5432/vcalm_status

# Origin of the signing service. Required when SIGNING_MODE=http.
# SIGNING_SERVICE_URL=http://localhost:4006

# HS256 secret for access tokens, shared with whatever mints them. Unset means
# only static tenant tokens authenticate — it never means auth is off.
# ACCESS_JWT_SECRET=

# ---------------------------------------------------------------------------
# Tenants (TENANT_REGISTRY_MODE=env)
#
# `pnpm provision-tenant --tenant acme` writes one of these blocks for you,
# mints the token and key material, and prints a ready-to-run curl. This is what
# the result looks like, and what to hand-write if you would rather.
# The tenant id is the suffix, lowercased — TENANT_TOKEN_ACME defines "acme".
# Only the token line is required. Issuer instances are numbered from 1 and
# read until a gap.
#
# TENANT_TOKEN_ACME=a-long-random-string      # comma-separated to rotate
# TENANT_DOMAINS_ACME=status.acme.test        # optional; PUBLIC_BASE_URL is
#                                             #   always allowed and unlisted
# TENANT_DEFAULT_INSTANCE_ACME=default        # optional when there is one
#
# TENANT_ISSUER_1_ID_ACME=default
# TENANT_ISSUER_1_CRYPTOSUITE_ACME=eddsa-rdfc-2022   # or ecdsa-rdfc-2019
# TENANT_ISSUER_1_DID_METHOD_ACME=key                # or web
# TENANT_ISSUER_1_DID_URL_ACME=https://acme.test     # did:web only
#
# One of these two forms of key material, for SIGNING_MODE=local:
# TENANT_ISSUER_1_SEED_ACME=z1Adw…                   # ed25519 suites
# TENANT_ISSUER_1_PUBLIC_KEY_ACME=zDna…              # ecdsa-rdfc-2019 needs
# TENANT_ISSUER_1_SECRET_KEY_ACME=z…                 #   both halves
#
# For SIGNING_MODE=http, where the remote holds the key instead:
# TENANT_ISSUER_1_SIGNING_TENANT_ACME=acme           # defaults to the tenant id
# TENANT_ISSUER_1_SIGNING_TOKEN_ACME=…
# TENANT_ISSUER_1_ISSUER_DID_ACME=did:web:acme.test
