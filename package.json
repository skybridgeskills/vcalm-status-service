{
  "name": "vcalm-status-service-workspace",
  "private": true,
  "type": "module",
  "description": "Workspace root for the VCALM status service and @skybridgeskills/vc-signer.",
  "scripts": {
    "build": "pnpm -r build",
    "start": "pnpm --filter @skybridgeskills/vcalm-status-service start",
    "dev": "pnpm --filter @skybridgeskills/vcalm-status-service dev",
    "test": "pnpm -r test",
    "lint": "eslint",
    "lint-fix": "eslint --fix",
    "format": "prettier --write .",
    "validate": "bash ./validate.sh",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.3.0",
    "eslint": "^9.3.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import-x": "^4.16.2",
    "globals": "^15.3.0",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.5",
    "prettier": "3.2.5",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.59.1"
  },
  "engines": {
    "node": ">=22.0"
  },
  "packageManager": "pnpm@10.13.1",
  "author": {
    "name": "Skybridge Skills",
    "url": "https://skybridgeskills.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/skybridgeskills/vcalm-status-service"
  },
  "homepage": "https://github.com/skybridgeskills/vcalm-status-service",
  "bugs": "https://github.com/skybridgeskills/vcalm-status-service/issues"
}
